<?xml version="1.0" encoding="utf-8"?>
<!--
  ghoztty-agent.wxs — per-user MSI for the Ghoztty Remote Agent (Windows).

  Compiled on macOS with wixl (GNOME msitools); stick to the WiX-v3 subset
  wixl understands. Build via relay/deploy/msi/build-msi.sh, which defines:

    Version    numeric ProductVersion derived from the release semver:
               X.Y.(Z*100+NN), e.g. v1.11.0 build 1 → 1.11.1 (ARP shows this)
    AgentStamp agent build stamp       (YYYYMMDD-<hash>, shown in ARP Comments)
    RelayUrl   relay base URL baked into the Run key + Start Menu shortcut
    SourceExe  path to the built ghoztty-agent.exe

  Design notes:
  - Per-user, no admin: InstallScope="perUser" (ALLUSERS stays unset) plus
    MSIINSTALLPERUSER=1. Everything lands under the user's profile/HKCU.
  - Installs to %LOCALAPPDATA%\Programs\Ghoztty Agent\ — REQUIRED: the agent
    self-updates by swapping its own exe, so the install dir must be
    user-writable without elevation.
  - The UpgradeCode GUID below is PERMANENT. Never change it, or upgrades
    stop replacing older installs. Product Id is regenerated per build ("*").
  - Component GUIDs are stable per component identity (MSI reference rules).
  - KillAgent custom action (taskkill, exit code ignored) runs before
    InstallValidate on install/upgrade/uninstall so the running tray exe
    doesn't trip the files-in-use dialog or a reboot-scheduled delete.
  - LegacyCleanup retires the pre-MSI install.ps1 layout (watchdog scheduled
    task + %LOCALAPPDATA%\ghoztty\ exe) so the old build can't respawn and
    hold the single-instance lock against the MSI-installed agent.
  - LaunchAgent starts the installed agent right after install/upgrade
    (asyncNoWait); the HKCU Run key covers subsequent logons.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Ghoztty Remote Agent"
           Manufacturer="dzearing"
           Version="$(var.Version)"
           UpgradeCode="7143BA66-FD7B-4D45-8555-E946D2141912"
           Language="1033">

    <Package InstallerVersion="500"
             InstallScope="perUser"
             Compressed="yes"
             Description="Ghoztty Remote Agent"
             Comments="Agent build $(var.AgentStamp)"/>

    <Media Id="1" Cabinet="agent.cab" EmbedCab="yes"/>

    <!-- Per-user install semantics (Windows 7+ dual-mode marker). -->
    <Property Id="MSIINSTALLPERUSER" Value="1"/>
    <!-- ARP metadata: numeric ProductVersion is what DisplayVersion shows;
         surface the human agent stamp via Comments. -->
    <Property Id="ARPCOMMENTS" Value="Agent build $(var.AgentStamp)"/>
    <Property Id="ARPNOMODIFY" Value="1"/>

    <!-- Major-upgrade behavior: ANY installed product with our UpgradeCode is
         removed when this one installs — deliberately including equal and
         "newer" versions. Whatever MSI the user runs wins. Two reasons:
         1. ProductVersion switched schemes (date-derived yy.m.dNN, e.g.
            26.7.601, → semver-derived, e.g. 1.11.1). Every semver compares
            "older" than every date version, so a downgrade block would
            permanently reject the new MSIs on already-installed boxes.
         2. There is a single download URL that always serves the latest
            build, and installed agents self-update — downgrade protection
            defends nothing here, while last-writer-wins gives free rollback. -->
    <Upgrade Id="7143BA66-FD7B-4D45-8555-E946D2141912">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="255.255.65535" IncludeMaximum="yes"
                      Property="EXISTINGVERSIONFOUND" MigrateFeatures="yes"/>
    </Upgrade>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Ghoztty Agent">

            <!-- The agent binary. Per-user component: HKCU registry value is
                 the keypath (user-profile file keypaths are unreliable across
                 users, and the self-updater rewrites the exe anyway — a file
                 keypath would invite MSI repair loops). -->
            <Component Id="AgentExe" Guid="0604C8BB-B0FD-4236-861F-6B18983AE6AA">
              <RegistryValue Root="HKCU"
                             Key="Software\dzearing\GhozttyAgent"
                             Name="InstallDir" Value="[INSTALLDIR]"
                             Type="string" KeyPath="yes"/>
              <File Id="AgentExeFile" Name="ghoztty-agent.exe"
                    Source="$(var.SourceExe)"/>
              <!-- wixl limitation: no Directory attribute on RemoveFolder
                   (it targets the component's directory) and no RemoveFile
                   element at all. So untracked self-update leftovers
                   (e.g. a staged/renamed old exe) can keep INSTALLDIR from
                   being deleted on uninstall; the tracked exe and all
                   registry values are still removed cleanly. -->
              <RemoveFolder Id="RemoveInstallDir" On="uninstall"/>
            </Component>

            <!-- Autostart at logon, pointed at the relay. -->
            <Component Id="AgentRunKey" Guid="A98EEBA9-5D7A-4147-A0B9-571CE1BB1C47">
              <RegistryValue Root="HKCU"
                             Key="Software\Microsoft\Windows\CurrentVersion\Run"
                             Name="GhozttyAgent"
                             Value="&quot;[INSTALLDIR]ghoztty-agent.exe&quot; --relay=$(var.RelayUrl)"
                             Type="string" KeyPath="yes"/>
            </Component>

          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu shortcut so the agent can be launched right after
           install (the Run key only fires at next logon). Non-advertised:
           explicit Target/Arguments; HKCU keypath per per-user rules. -->
      <Directory Id="ProgramMenuFolder">
        <Component Id="AgentShortcut" Guid="53C2F210-3C13-4BE6-91FA-0F5550CDE7BE">
          <RegistryValue Root="HKCU"
                         Key="Software\dzearing\GhozttyAgent"
                         Name="Shortcut" Value="1"
                         Type="integer" KeyPath="yes"/>
          <Shortcut Id="AgentStartMenuShortcut"
                    Name="Ghoztty Agent"
                    Target="[INSTALLDIR]ghoztty-agent.exe"
                    Arguments="--relay=$(var.RelayUrl)"
                    WorkingDirectory="INSTALLDIR"
                    Description="Connect this machine to your Ghoztty terminal"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Agent" Level="1" Title="Ghoztty Remote Agent">
      <ComponentRef Id="AgentExe"/>
      <ComponentRef Id="AgentRunKey"/>
      <ComponentRef Id="AgentShortcut"/>
    </Feature>

    <!-- Retire the legacy install.ps1 layout (%LOCALAPPDATA%\ghoztty\ exe + a
         run-agent.ps1 watchdog kept alive by a 'GhozttyAgent' scheduled task /
         Startup shortcut). The watchdog is a powershell.exe, so KillAgent's
         taskkill of ghoztty-agent.exe does NOT stop it — it would respawn the
         OLD exe within 3 seconds of the kill, win the single-instance lock,
         and the freshly installed agent would silently exit forever after
         (exit 183). Order matters: kill the watchdog FIRST (tree-kill takes
         its agent child with it), then unhook its logon triggers, then remove
         the old binaries. relay.env and logs in the same dir are shared state
         and deliberately kept. Runs on install/upgrade, not uninstall.
         wixl limitation: no Directory attribute on CustomAction (type 34),
         so use type 51 (set property to the formatted exe path) + type 50
         (run the exe named by that property) — same pattern as KillAgent. -->
    <CustomAction Id="SetLegacyCleanupCmd"
                  Property="LEGACYCLEANUPCMD"
                  Value="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"/>
    <CustomAction Id="LegacyCleanup"
                  Property="LEGACYCLEANUPCMD"
                  ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$$d=Join-Path $$env:LOCALAPPDATA 'ghoztty'; $$pf=Join-Path $$d 'launcher.pid'; if(Test-Path $$pf){$$w=Get-Content $$pf -ErrorAction SilentlyContinue; if($$w){taskkill /F /T /PID $$w 2&gt;$$null}; Remove-Item $$pf -ErrorAction SilentlyContinue}; schtasks /Delete /TN GhozttyAgent /F 2&gt;$$null; Remove-Item -ErrorAction SilentlyContinue (Join-Path $$env:APPDATA 'Microsoft\Windows\Start Menu\Programs\Startup\ghoztty-agent.cmd'); taskkill /F /IM ghoztty-agent.exe 2&gt;$$null; Start-Sleep -Milliseconds 400; Remove-Item -ErrorAction SilentlyContinue (Join-Path $$d 'ghoztty-agent.exe'),(Join-Path $$d 'run-agent.ps1')&quot;"
                  Execute="immediate"
                  Return="ignore"/>

    <!-- Stop a running agent so its exe isn't locked during install,
         upgrade, or uninstall. taskkill exits nonzero when no process
         matches — Return="ignore" makes that a no-op. Kept as a backstop
         even though LegacyCleanup also taskkills: LegacyCleanup is
         conditioned out on uninstall, and powershell could be blocked by
         policy on some box. -->
    <CustomAction Id="SetKillAgentCmd"
                  Property="KILLAGENTCMD"
                  Value="[SystemFolder]taskkill.exe"/>
    <CustomAction Id="KillAgent"
                  Property="KILLAGENTCMD"
                  ExeCommand="/F /IM ghoztty-agent.exe"
                  Execute="immediate"
                  Return="ignore"/>

    <!-- Start the freshly installed agent as the last install step, so the
         tray icon appears immediately instead of at next logon (the Run key
         handles logons from then on). asyncNoWait: the agent is a daemon —
         the installer must not wait for it to exit. Skipped on uninstall
         (Installed is set once THIS product is registered; a fresh install
         or a major upgrade's new package sees it empty). -->
    <CustomAction Id="SetLaunchAgentCmd"
                  Property="LAUNCHAGENTCMD"
                  Value="[INSTALLDIR]ghoztty-agent.exe"/>
    <CustomAction Id="LaunchAgent"
                  Property="LAUNCHAGENTCMD"
                  ExeCommand="--relay=$(var.RelayUrl)"
                  Execute="immediate"
                  Return="asyncNoWait"/>

    <InstallExecuteSequence>
      <Custom Action="SetLegacyCleanupCmd" Before="LegacyCleanup"/>
      <Custom Action="LegacyCleanup" Before="SetKillAgentCmd">NOT REMOVE</Custom>
      <Custom Action="SetKillAgentCmd" Before="KillAgent"/>
      <Custom Action="KillAgent" Before="InstallValidate"/>
      <RemoveExistingProducts After="InstallValidate"/>
      <Custom Action="SetLaunchAgentCmd" Before="LaunchAgent"/>
      <Custom Action="LaunchAgent" After="InstallFinalize">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
