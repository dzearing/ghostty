# Ad-hoc per-task prefixes (zig-out-t206/ etc). Without this a `git add -A`
# stages a whole build tree.
zig-out-*/
build-cmake/
CMakeCache.txt
CMakeFiles/
/build.zig.zon.bak
/result*
/.nixos-test-history
example/*.wasm
test/ghostty
test/cases/**/*.actual.png
flatpak/builddir/
flatpak/repo/

glad.zip
/Box_test.ppm
/Box_test_diff.ppm
/ghostty.qcow2

vgcore.*

temp/
macos/macos/
.superpowers/

# Ephemeral git worktrees created by Claude Code subagents
.claude/worktrees/
.dumps/

# Local Google OAuth client id for dev builds (never commit; injected via
# -Dgoogle-client-id in CI). The id is public but managed as build config.
# The repo-root path is the one to use - the id is baked into the Windows
# binary too, so it is not a macOS-only setting (T747).
google-client-id.txt
macos/google-client-id.txt

# Backfill drafts (raw GitHub bodies to curate from; not shipped)
release-notes/.drafts/

# Debug PNGs the sprite-face unit test (src/font/sprite/Face.zig) writes into
# the test runner's cwd; generated on every win32 test-lane run, never source.
sprite_face_test-*.png

# MSYS tools drop these next to the cwd when they crash (e.g. grep -F
# aborting under Git Bash on this box); never source.
*.stackdump
# Local, non-committed working files (dot-issues reviews, scratch)
.local/

# `msiinfo export <msi> Binary` dumps binary-stream columns to ./Binary/ in the
# CWD. build-msi.sh exports from a scratch dir so this shouldn't appear, but a
# manual msiinfo run from the repo root still would — and one such dump got
# committed once already.
/Binary/
